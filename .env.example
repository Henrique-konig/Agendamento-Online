# Copie para .env.local e preencha. Nunca faça commit de .env.local.

# URL pública do site (sem barra no final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Banco de dados — Neon (https://neon.tech). Em "Connect", copie as duas strings:
# DATABASE_URL: conexão com pooler (host termina em -pooler), usada pelo app.
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
# DIRECT_URL: conexão direta (sem -pooler), usada só nas migrations (npm run db:migrate).
# (A integração Vercel + Neon cria DATABASE_URL_UNPOOLED, que também é aceita.)
DIRECT_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Fotos — Vercel Blob. Criado em Vercel > Storage > Create > Blob; a variável é injetada sozinha.
BLOB_READ_WRITE_TOKEN=

# --- E-mail e lembretes ---------------------------------------------------------
# Escolha UM provedor. SMTP tem prioridade; sem SMTP, usa a API do Resend.
#
# Gmail (sem domínio): ative a verificação em duas etapas e crie uma "senha de app"
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=seuemail@gmail.com
#   EMAIL_FROM="Agenda Autônomo <seuemail@gmail.com>"
# Brevo: SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  (usuário e chave SMTP do painel)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Resend (alternativa) — exige domínio verificado para enviar a qualquer pessoa
RESEND_API_KEY=
EMAIL_FROM="Agenda Autônomo <nao-responda@seudominio.com.br>"
# Segredo enviado pelo agendador (Vercel Cron) no cabeçalho Authorization
CRON_SECRET=
# Avisos no celular (Web Push). Gere o par com: npx web-push generate-vapid-keys
# A chave privada é segredo; VAPID_SUBJECT é um e-mail de contato (mailto:você@email.com).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# WhatsApp Cloud API (Meta). Opcional; sem estas variáveis o canal fica desligado.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_REMINDER_TEMPLATE=lembrete_agendamento
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# --- Etapa 4: Google Agenda ----------------------------------------------------
# Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth (Web)
# URI de redirecionamento autorizado: <NEXT_PUBLIC_SITE_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 bytes em base64 — gere com: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- Etapa 5: Pix ---------------------------------------------------------------
# Criptografa os tokens do Mercado Pago dos profissionais (openssl rand -base64 32).
# Necessária apenas para o modo Mercado Pago; o Pix "copia e cola" funciona sem ela.
PAYMENT_ENCRYPTION_KEY=
