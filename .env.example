NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNkbW92b2dlZGtnend6bGx0bXdvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTI1MDk0NTYsImV4cCI6MjEwODA4NTQ1Nn0.3jc9V2vc_0bM0C8SPMLp6ReRc5eRrz3ValSaJXZGboI
# Somente servidor. Usada para operações públicas validadas (ex.: criar agendamento).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNkbW92b2dlZGtnend6bGx0bXdvIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MjUwOTQ1NiwiZXhwIjoyMTA4MDg1NDU2fQ.TV8P7qEivZ_V5l3jqrDOroXei80RIQ2M19cSfwJMHsg

# --- Etapa 3: lembretes -------------------------------------------------------
# Resend (https://resend.com) — domínio verificado para o remetente
RESEND_API_KEY=
EMAIL_FROM="Agenda Autônomo <nao-responda@seudominio.com.br>"
# Segredo enviado pelo agendador (Vercel Cron) no cabeçalho Authorization
CRON_SECRET=
# WhatsApp Cloud API (Meta). Opcional; sem estas variáveis o canal fica desligado.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_REMINDER_TEMPLATE=lembrete_agendamento
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# --- Etapa 4: Google Agenda ----------------------------------------------------
# Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth (Web)
# URI de redirecionamento autorizado: <NEXT_PUBLIC_SITE_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 bytes em base64 — gere com: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- Etapa 5: Pix ---------------------------------------------------------------
# Criptografa os tokens do Mercado Pago dos profissionais (openssl rand -base64 32).
# Necessária apenas para o modo Mercado Pago; o Pix "copia e cola" funciona sem ela.
PAYMENT_ENCRYPTION_KEY=
